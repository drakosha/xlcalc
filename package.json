{
  "name": "xlcalc",
  "version": "0.59.1",
  "description": "Excel-style formula engine for workbooks: compiles a book's formulas to JavaScript, recalculates incrementally, hashes values deterministically, and checks its function whitelist against Excel semantics",
  "keywords": [
    "formula",
    "formula-engine",
    "excel",
    "spreadsheet",
    "workbook",
    "xlsx",
    "calculation",
    "recalculation",
    "deterministic",
    "sumifs",
    "xlookup"
  ],
  "license": "MIT",
  "author": "Mikhail Kostryukov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drakosha/xlcalc.git"
  },
  "homepage": "https://xlcalc.pridelab.dev",
  "bugs": {
    "url": "https://github.com/drakosha/xlcalc/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./a1": {
      "types": "./dist/a1.d.ts",
      "default": "./dist/a1.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./entry": {
      "types": "./dist/typed-entry.d.ts",
      "default": "./dist/typed-entry.js"
    },
    "./function-text": {
      "types": "./dist/function-text/index.d.ts",
      "default": "./dist/function-text/index.js"
    },
    "./function-text/ru-RU": {
      "types": "./dist/function-text/ru-RU.d.ts",
      "default": "./dist/function-text/ru-RU.js"
    },
    "./unstable/internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./unstable/synth": {
      "types": "./dist/synth.d.ts",
      "default": "./dist/synth.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "default": "./dist/xlsx.js"
    },
    "./xlsx/keep": {
      "types": "./dist/xlsx-keep.d.ts",
      "default": "./dist/xlsx-keep.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./worker/thread": {
      "types": "./dist/worker/thread.d.ts",
      "default": "./dist/worker/thread.js"
    },
    "./locales/ru-RU": {
      "types": "./dist/locales/ru-RU.d.ts",
      "default": "./dist/locales/ru-RU.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/*.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build && node test/suites.mjs",
    "test:dist": "npm run build && FORMULA_TARGET=dist node test/suites.mjs",
    "test:oracle": "FORMULA_ORACLE=update vitest run test/semantics.test.ts",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "pack:release": "npm run build && mkdir -p release && npm pack --pack-destination release",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@formulajs/formulajs": "4.6.1",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "playwright-core": "1.63.0",
    "publint": "^0.3.25",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
