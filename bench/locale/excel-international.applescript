-- Excel's international settings (Application.International): separators, date order, format codes,
-- currency. Read only. Output: JSON object by the setting's name.
use AppleScript version "2.4"
use framework "Foundation"
use scripting additions

on run argv
	set names to {"decimal separator", "thousands separator", "list separator", "column separator", "row separator", "alternate array separator", "left brace", "right brace", "left bracket", "right bracket", "upper case row letter", "upper case column letter", "lower case row letter", "lower case column letter", "date_separator", "time separator", "date_order", "mdy", "four digit years", "day leading zero", "month_leading_zero", "time leading zero", "twenty_four_hour clock", "year code", "month_code", "day code", "hour code", "minute_code", "second code", "general format name", "currency_code", "currency_before", "currency_space_before", "currency_digits", "currency_negative", "currency_minus_sign", "currency_leading_zeros", "currency_trailing_zeros", "noncurrency_digits", "month_name_chars", "weekday_name_chars", "country_code", "country_setting", "metric", "non english functions"}
	tell application "Microsoft Excel"
		set vals to {get international data type decimal separator, get international data type thousands separator, get international data type list separator, get international data type column separator, get international data type row separator, get international data type alternate array separator, get international data type left brace, get international data type right brace, get international data type left bracket, get international data type right bracket, get international data type upper case row letter, get international data type upper case column letter, get international data type lower case row letter, get international data type lower case column letter, get international data type date_separator, get international data type time separator, get international data type date_order, get international data type mdy, get international data type four digit years, get international data type day leading zero, get international data type month_leading_zero, get international data type time leading zero, get international data type twenty_four_hour clock, get international data type year code, get international data type month_code, get international data type day code, get international data type hour code, get international data type minute_code, get international data type second code, get international data type general format name, get international data type currency_code, get international data type currency_before, get international data type currency_space_before, get international data type currency_digits, get international data type currency_negative, get international data type currency_minus_sign, get international data type currency_leading_zeros, get international data type currency_trailing_zeros, get international data type noncurrency_digits, get international data type month_name_chars, get international data type weekday_name_chars, get international data type country_code, get international data type country_setting, get international data type metric, get international data type non english functions}
	end tell
	set dict to current application's NSDictionary's dictionaryWithObjects:vals forKeys:names
	set {d, e} to current application's NSJSONSerialization's dataWithJSONObject:dict options:0 |error|:(reference)
	if d is missing value then error "JSON: " & (e's localizedDescription() as text)
	return (current application's NSString's alloc()'s initWithData:d encoding:4) as text
end run
