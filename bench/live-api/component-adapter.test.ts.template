import { Worker as NodeWorker } from 'node:worker_threads'
import { createRequire } from 'node:module'
import { URL as NodeURL, pathToFileURL } from 'node:url'
import { describe, expect, it, vi } from 'vitest'
import { createInlineCalc, type AsyncSession, type BookInput, type Calc } from 'xlcalc'
import { createCalcPool } from 'xlcalc/worker'
import { parseCell } from 'xlcalc/a1'
import { localSource } from '../src/local'
import type { SourceEvent, FindRequest } from '../src/source'
import { mountSheet, settle } from './helpers'
const clock={now:'2026-10-04T12:00:00Z',seed:7}
describe.each(['closures','eval'] as const)('live API adapter, %s',execution=>{
 it.each(['inline','pool'] as const)('shows an agent batch in the component and searches where the book lives, %s',async kind=>{
  const calc=kind==='inline'?createInlineCalc():createCalcPool({threads:1,spawn:()=>{
   const entry=createRequire(import.meta.url).resolve('xlcalc/worker')
   const worker=new NodeWorker(new NodeURL('./thread.js',pathToFileURL(entry)),{execArgv:[]})
   return {postMessage:m=>worker.postMessage(m),terminate:()=>{void worker.terminate()},addEventListener:(type,listener)=>{
    if(type==='message')worker.on('message',data=>listener({data}))
    else worker.on(type,e=>listener({message:String(e)}))
   }}
  }})
  let session:AsyncSession|undefined
  const supplied=new Proxy(calc,{get(target,key){
   if(key==='createSession')return async(book:BookInput,opts:Parameters<Calc['createSession']>[1])=>session=await target.createSession(book,opts)
   return Reflect.get(target,key)
  }})
  const base=localSource({sheets:[{name:'S',cells:{A1:{value:2},B1:{formula:'A1*2'},C1:{formula:'B1+3'},D1:{value:'hello'}}}]},{calc:supplied,session:{clock,execution}})
  const listeners=new Set<(e:SourceEvent)=>void>()
  const source=new Proxy(base,{get(target,key){
   if(key==='subscribe')return (f:(e:SourceEvent)=>void)=>{listeners.add(f);return ()=>listeners.delete(f)}
   if(key==='find')return async({sheet,query,range,matchCase}:FindRequest)=>{
    const p=await session!.findCells([{sheet,range:range??'A1:D1'}],query,{maxCells:500,fields:['text'],count:true,caseSensitive:matchCase})
    return {hits:p.cells.map(c=>({...parseCell(c.cell)!,text:c.text??''})),total:p.total??p.cells.length}
   }
   return Reflect.get(target,key)
  }})
  let view:Awaited<ReturnType<typeof mountSheet>>|undefined
  try{
   await base.ready;view=await mountSheet(source)
   await vi.waitFor(()=>expect(view!.find('[data-cell="1:3"]').text()).toContain('7'))
   const ops=[{op:'setCells' as const,edits:[{sheet:'S',cell:'B1',input:{formula:'A1*Rate'}}]},{op:'setNames' as const,names:[{name:'Rate',ref:'3'}]},{op:'patchCells' as const,patches:[{sheet:'S',range:'B1',set:{numberFormat:'0.00',style:{font:{bold:true}}}}]}]
   const preview=await session!.previewChanges(ops,{clock})
   expect(preview.impacts.find(c=>c.cell==='C1')).toMatchObject({before:7,after:9})
   expect(view.find('[data-cell="1:3"]').text()).toContain('7')
   const changed=await session!.applyChanges(ops,{baseRevision:preview.revision,clock:preview.clock})
   expect(changed.revision).toBe(1)
   for(const f of listeners)f({kind:'reload'})
   await settle(12)
   await vi.waitFor(()=>expect(view!.find('[data-cell="1:3"]').text()).toContain('9'))
   expect(view.find('[data-cell="1:2"]').text()).toContain('6.00')
   expect((await source.find({sheet:'S',query:'HEL',lookIn:'values'})).hits[0]).toMatchObject({row:1,col:4,text:'hello'})
   expect(await session!.summarizeRanges([{sheet:'S',range:'A1:D1'}])).toMatchObject({cells:4,numbers:3,sum:17})
  }finally{view?.unmount();await base.close();await calc.close();document.body.innerHTML=''}
 })
})
